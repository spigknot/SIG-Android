{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sig:granite:phase-report:v2",
  "title": "Granite executor phase report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase_id", "order_revision", "attempt_id", "status",
    "started_at", "finished_at", "baseline", "configuration_refs", "tasks",
    "claims", "metrics", "checks", "artifacts", "limitations", "next_recommendation"
  ],
  "properties": {
    "schema_version": {"const": "sig-granite-phase-report/v2"},
    "phase_id": {"type": "string", "pattern": "^F(0[0-9]|1[0-2]|AR)$"},
    "order_revision": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["concluida_para_revisao", "parcial", "bloqueada_em_recurso", "falhou"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "baseline": {
      "type": "object",
      "required": ["commit", "branch", "dirty_before", "preserved_paths"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string"},
        "dirty_before": {"type": "boolean"},
        "preserved_paths": {"type": "array", "items": {"type": "string"}},
        "patch_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "configuration_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence", "reason"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["realizada", "parcial", "pendente", "nao_aplicavel"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "scope", "level", "evidence"],
        "properties": {
          "claim": {"type": "string"},
          "scope": {"type": "string"},
          "level": {
            "enum": ["observado", "funcional", "numerico", "qualidade", "performance", "hipotese"]
          },
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "source", "method", "missing_reason"],
        "properties": {
          "name": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "method": {"type": "string"},
          "missing_reason": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"value": {"type": "null"}}},
            "then": {"properties": {"missing_reason": {"type": "string", "minLength": 1}}}
          },
          {
            "if": {"properties": {"value": {"type": "number"}}},
            "then": {"properties": {"source": {"type": "string", "minLength": 1}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "exit_code", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["passou", "falhou", "nao_executado", "nao_aplicavel"]},
          "exit_code": {"type": ["integer", "null"]},
          "evidence": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_recommendation": {"type": "string", "minLength": 1}
  }
}
