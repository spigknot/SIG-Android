# Fixtures de pacotes nativos (artefatos de teste, nao entram no Git)
app/src/test/resources/native-deps/*.zip
# Harness e artefatos de diagnostico nativos
native-dependencies/harness/
native-dependencies/diag-norm/
native-dependencies/build/
# Excecao ESPECIFICA: fontes de teste versionadas (native-dependencies/tests/
# contem so CPP/SH/H/fixtures minimas — binarios/logs continuam fora).
!native-dependencies/tests/
!native-dependencies/tests/**
# Artefatos de rodada OpenCL (preserva .txt/.md de relatorio)
docs/opencl-hymt2/logs-rodada-opencl/*
!docs/opencl-hymt2/logs-rodada-opencl/*.txt
!docs/opencl-hymt2/logs-rodada-opencl/*.md
# Artefatos das rodadas Vulkan (preserva .txt/.md de relatorio/prompt)
docs/vulkan-hymt2-fusion-round/**
!docs/vulkan-hymt2-fusion-round/**/*.txt
!docs/vulkan-hymt2-fusion-round/**/*.md
# Midia de teste
emul_test_media/
