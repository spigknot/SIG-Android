<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="SIG"
        android:name=".SigApplication"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SIG">

        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <!-- FastRPC exposto pelo vendor em /vendor/etc/public.libraries.txt.
             Desde targetSdk 31, libs nativas públicas do fabricante só entram no
             namespace do app quando declaradas aqui. Mantemos opcionais porque o
             SIG também precisa instalar e funcionar em aparelhos não-Qualcomm. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libadsprpc.so"
            android:required="false" />

        <!-- O onnxruntime-android registra um ContentProvider (TelemetryInitializer) que roda
             ANTES do Application.onCreate() e faz System.loadLibrary("onnxruntime"). Além de
             telemetria indesejada, isso carregaria os ~32MB da lib ONNX a CADA abertura do app
             (mesmo sem usar o Granite) e, em aparelhos com onnxruntime OEM no /system/lib64,
             forçaria o fallback que estoura o namespace clns-9. Removemos o provider. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <activity
            android:name=".RgCalculatorActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ImeiCalculatorActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ImeiSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".FfmpegCutActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="SIG - Cortar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FfmpegExtractAudioActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="SIG - Extrair áudio">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FfmpegRotateVideoActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".FfmpegJoinVideosActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".FfmpegCleanAudioActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".FfmpegInsertAudioActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".WhisperActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".GraniteActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:largeHeap="true" />

        <activity
            android:name=".experimental.npu.NpuTestActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".RemoteSttActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="SIG - Transcrever Granite">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ModelSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ApiKeysSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".AdvancedSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".FfmpegActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SIG"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ToolsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".CalculatorToolsActivity" android:screenOrientation="portrait" android:exported="false" />
    </application>
</manifest>
