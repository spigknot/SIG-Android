<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SIG.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.SIG" parent="Theme.SIG.Base" />
    <style name="NpuSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NpuOutputBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#99070D10</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">#FFE4F4F4</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
