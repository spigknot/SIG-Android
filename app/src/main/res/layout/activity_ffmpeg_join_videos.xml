<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/join_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Juntar áudios/vídeos"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_select_videos"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Selecionar áudios ou vídeos"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_select_file" />

                <ImageView
                    android:id="@+id/arrow_input_output"
                    android:contentDescription="@null"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#FFFFFFFF"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/button_select_output_folder"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Selecionar pasta de saída"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_folder"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/selected_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Nenhum áudio ou vídeo selecionado"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/join_media_area"
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:layout_marginTop="12dp">

                <HorizontalScrollView
                    android:id="@+id/timeline_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:scrollbars="horizontal">

                    <br.gov.sp.pcsp.launcher.FfmpegJoinTimelineView
                        android:id="@+id/join_timeline"
                        android:layout_width="wrap_content"
                        android:layout_height="128dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/result_preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextureView
                        android:id="@+id/result_video_preview"
                        android:layout_width="match_parent"
                        android:layout_height="74dp"
                        android:scaleX="0.8"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/result_playback_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/result_speed_down"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Desacelerar"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_ffmpeg_speed_down"
                            app:tint="#FFFFFFFF" />

                        <ImageButton
                            android:id="@+id/result_play_pause"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Reproduzir"
                            android:padding="2dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_ffmpeg_play"
                            app:tint="#FFFFFFFF" />

                        <ImageButton
                            android:id="@+id/result_speed_up"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Acelerar"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_ffmpeg_speed_up"
                            app:tint="#FFFFFFFF" />
                    </LinearLayout>

                    <br.gov.sp.pcsp.launcher.FfmpegRangeSlider
                        android:id="@+id/result_timeline"
                        android:layout_width="match_parent"
                        android:layout_height="24dp" />

                    <TextView
                        android:id="@+id/result_current_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="00:00"
                        android:textColor="#AAFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/join_playback_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <br.gov.sp.pcsp.launcher.FfmpegJoinPlaybackTimelineView
                    android:id="@+id/join_playback_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:enabled="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/join_speed_down"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Desacelerar"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_speed_down"
                        app:tint="#FFFFFFFF" />

                    <ImageButton
                        android:id="@+id/join_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reproduzir"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_play"
                        app:tint="#FFFFFFFF" />

                    <ImageButton
                        android:id="@+id/join_speed_up"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Acelerar"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_speed_up"
                        app:tint="#FFFFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/join_current_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="00:00:00.000"
                    android:textColor="#AAFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/join_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/button_transition"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minWidth="132dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Transição: Fade in/out"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/help_transition"
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="40dp"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/input_transition_time"
                        android:layout_width="68dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:digits="0123456789.,"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:hint="seg"
                        android:inputType="numberDecimal"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:text="0.5"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#88FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/check_reencode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFFFFFFF"
                        android:text="Reencode Completo"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/help_reencode"
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="40dp"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/smart_join_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/check_smart_join"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFFFFFFF"
                        android:text="SmartJoin"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/help_smart_join"
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="40dp"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/video_encoding_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/label_video_encoder"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="Encoder:"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/button_video_encoder"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="..."
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/help_video_encoder"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/label_video_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:text="Qualidade:"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/button_video_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="Alta"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/help_video_quality"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_join"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:alpha="0.45"
                    android:background="@drawable/ffmpeg_outline_green_button_bg"
                    android:clickable="false"
                    android:contentDescription="Juntar áudios ou vídeos"
                    android:focusable="false"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_join_videos" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textSize="13sp" />
<TextView
                android:id="@+id/output_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF5EDAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
<LinearLayout
                android:id="@+id/output_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_save_to_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Salvar na pasta"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_save" />

                <ImageButton
                    android:id="@+id/button_output_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir pasta"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_folder" />

                <ImageButton
                    android:id="@+id/button_output_share"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Compartilhar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_share" />
            </LinearLayout>

            <TextView
                android:id="@+id/output_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="#FF2ECC71"
                android:textSize="12sp"
                android:visibility="gone" />


            

            
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
