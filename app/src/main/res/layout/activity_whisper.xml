<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_ferramentas" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <ScrollView
        android:id="@+id/whisper_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Whisper"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <ImageButton
                    android:id="@+id/button_select_media"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Selecionar áudio ou vídeo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_select_file" />

                <ImageView
                    android:id="@+id/arrow_input_output"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#88FFFFFF"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/button_select_output_folder"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Selecionar pasta de saída"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_folder"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/terminal_text"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="0dp"
                android:background="#CC050607"
                android:fontFamily="monospace"
                android:maxLines="40"
                android:minLines="40"
                android:overScrollMode="ifContentScrolls"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text="$ whisper --aguardando arquivo"
                android:textColor="#FFB8F7FF"
                android:textIsSelectable="false"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/selected_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_model"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Modelo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/button_language"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:gravity="center"
                    android:text="pt"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/button_backend"
                    android:layout_width="104dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:gravity="center"
                    android:text="CPU"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/button_transcribe"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:alpha="0.45"
                android:background="@drawable/ffmpeg_outline_green_button_bg"
                android:clickable="false"
                android:contentDescription="Transcrever"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_whisper_transcribe"
                android:visibility="gone" />

            <TextView
                android:id="@+id/advanced_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:text="Configurações Avançadas"
                android:textColor="#FF5EDAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/advanced_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:background="#661B1B1B"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/checkbox_vad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FF5EDAF2"
                    android:text="VAD filter"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/checkbox_flash_attention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FF5EDAF2"
                    android:text="Flash attention"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/checkbox_word_timestamps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FF5EDAF2"
                    android:text="Word timestamps"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beam size"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/help_beam_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:padding="4dp"
                        android:text="?"
                        android:textColor="#FF5EDAF2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_beam_size_dec"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_left"
                        android:contentDescription="Diminuir Beam Size"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/input_beam_size"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:gravity="center"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:text="5" />

                    <ImageButton
                        android:id="@+id/btn_beam_size_inc"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="Aumentar Beam Size"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Best of"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/help_best_of"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:padding="4dp"
                        android:text="?"
                        android:textColor="#FF5EDAF2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_best_of_dec"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_left"
                        android:contentDescription="Diminuir Best of"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/input_best_of"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:gravity="center"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:text="5" />

                    <ImageButton
                        android:id="@+id/btn_best_of_inc"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="Aumentar Best of"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reset_advanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="redefinir"
                    android:textColor="#FF5EDAF2"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/output_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF5EDAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/output_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_save_to_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Salvar na pasta"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_save" />

                <ImageButton
                    android:id="@+id/button_output_export"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Exportar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_whisper_export" />

                <ImageButton
                    android:id="@+id/button_output_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir pasta"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_folder" />
            </LinearLayout>

            <TextView
                android:id="@+id/log_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:text="log"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:background="#881B1B1B"
                android:fontFamily="monospace"
                android:maxLines="30"
                android:minLines="30"
                android:overScrollMode="ifContentScrolls"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:visibility="visible" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
