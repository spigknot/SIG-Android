<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- Imagem de fundo centralizada (não empurra nada) -->
    <ImageView
        android:id="@+id/bgLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/ic_launcher"
        android:scaleType="center"
        android:contentDescription="Logo do SIG"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Conteúdo rolável com os botões (por cima da imagem) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Botão Talão Web -->
            <Button
                android:id="@+id/btnTalao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:padding="12dp"
                android:text="Talão Web" />

            <Button
                android:id="@+id/button_mind7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="56dp"
                android:padding="12dp"
                android:text="Mind-7"
                android:tag="https://mind-7.org/painel/" />

            <!-- Botão Infoseg -->
            <Button
                android:id="@+id/button_infoseg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="56dp"
                android:padding="12dp"
                android:text="Infoseg"
                android:tag="http://infoseg.sinesp.gov.br/infoseg2/" />

            <Button
                android:id="@+id/button_esaj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="56dp"
                android:padding="12dp"
                android:text="eSAJ"
                android:tag="https://esaj.tjsp.jus.br/cpopg/open.do" />

            <Button
                android:id="@+id/button_bnmp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="56dp"
                android:padding="12dp"
                android:text="BNMP"
                android:tag="https://portalbnmp.cnj.jus.br/#/pesquisa-peca" />



            <!-- Espaçador para não encostar na assinatura -->
            <View
                android:layout_width="match_parent"
                android:layout_height="72dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Botão Ferramentas -->
    <Button
        android:id="@+id/button_tools"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginTop="16dp"
        android:minHeight="50dp"
        android:padding="12dp"
        android:text="Ferramentas" />

    <!-- Assinatura fixa no rodapé -->
    <TextView
        android:id="@+id/footerSignature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIG de Taguaí"
        android:textSize="12sp"
        android:textColor="#FFFFFFFF"
        android:alpha="0.9"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/credit_badge"
        android:layout_gravity="bottom|right"
        android:layout_margin="12dp" />

</FrameLayout>
