<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Imagem de fundo centralizada (não empurra nada) -->
    <ImageView
        android:id="@+id/bgLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wallpaper_app_sig"
        android:scaleType="fitCenter"
        android:contentDescription="Logo do SIG"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="168dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:padding="14dp"
            android:useDefaultMargins="true">

            <LinearLayout
                android:id="@+id/shortcut_talao"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="78dp"
                    android:contentDescription="Talão Web"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_talao_car" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Talão Web"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_mind7"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="78dp"
                    android:contentDescription="Mind-7"
                    android:padding="18dp"
                    android:src="@drawable/ic_shortcut_search" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Mind-7"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_infoseg"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="78dp"
                    android:contentDescription="Infoseg"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_infoseg_inv" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Infoseg"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_esaj"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="78dp"
                    android:contentDescription="eSAJ"
                    android:padding="18dp"
                    android:src="@drawable/ic_shortcut_court" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="eSAJ"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcut_bnmp"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="79dp"
                    android:layout_height="78dp"
                    android:contentDescription="BNMP"
                    android:padding="15dp"
                    android:src="@drawable/ic_shortcut_handcuffs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="BNMP"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </GridLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/shortcut_tools"
        android:layout_width="156dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:background="@drawable/shortcut_tools_panel_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Ferramentas"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shortcut_tools_panel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Ferramentas"
            android:textColor="#FF5EDAF2"
            android:textSize="10sp" />
    </LinearLayout>

    <include layout="@layout/view_sig_echo_footer" />

</FrameLayout>
