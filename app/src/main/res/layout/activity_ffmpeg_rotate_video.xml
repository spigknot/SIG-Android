<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/rotate_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Girar vídeo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/preview_frame"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:background="@android:color/transparent">

                <TextureView
                    android:id="@+id/video_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginTop="36dp"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/button_select_video"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:contentDescription="Selecionar vídeo"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_select_file" />

                    <ImageView
                        android:id="@+id/arrow_input_output"
                        android:contentDescription="@null"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#FFFFFFFF"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/button_select_output_folder"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:contentDescription="Selecionar pasta de saída"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_folder"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/rotate_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/playback_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/button_speed_down"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Desacelerar"
                        android:focusable="true"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_speed_down" />

                    <ImageButton
                        android:id="@+id/button_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Reproduzir"
                        android:focusable="true"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_play" />

                    <ImageButton
                        android:id="@+id/button_speed_up"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Acelerar"
                        android:focusable="true"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ffmpeg_speed_up" />
                </LinearLayout>

                <br.gov.sp.pcsp.launcher.FfmpegRangeSlider
                    android:id="@+id/timeline"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="-8dp"
                    android:enabled="false"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp" />

                <TextView
                    android:id="@+id/playback_speed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="1x"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/current_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="00:00:00.000"
                    android:textColor="#AAFFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/time_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginEnd="32dp"
                            android:gravity="center"
                            android:text="Início"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/button_from_prev"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Diminuir início"
                                android:src="@drawable/ic_ffmpeg_minus"
                                app:tint="#FFFFFFFF" />

                            <EditText
                                android:id="@+id/input_from"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:backgroundTint="#555555"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:hint="00:00:00.000"
                                android:inputType="text"
                                android:maxLines="1"
                                android:padding="9dp"
                                android:selectAllOnFocus="true"
                                android:textColor="#FFFFFFFF"
                                android:textColorHint="#88FFFFFF"
                                android:textSize="13sp" />

                            <ImageButton
                                android:id="@+id/button_from_next"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Aumentar início"
                                android:src="@drawable/ic_ffmpeg_plus"
                                app:tint="#FFFFFFFF" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginEnd="32dp"
                            android:gravity="center"
                            android:text="Fim"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/button_to_prev"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Diminuir fim"
                                android:src="@drawable/ic_ffmpeg_minus"
                                app:tint="#FFFFFFFF" />

                            <EditText
                                android:id="@+id/input_to"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:backgroundTint="#555555"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:hint="00:00:00.000"
                                android:inputType="text"
                                android:maxLines="1"
                                android:padding="9dp"
                                android:selectAllOnFocus="true"
                                android:textColor="#FFFFFFFF"
                                android:textColorHint="#88FFFFFF"
                                android:textSize="13sp" />

                            <ImageButton
                                android:id="@+id/button_to_next"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Aumentar fim"
                                android:src="@drawable/ic_ffmpeg_plus"
                                app:tint="#FFFFFFFF" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rotation_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rotate_minus_90"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFFFFFFF"
                        android:text="-90°"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rotate_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:buttonTint="#FFFFFFFF"
                        android:checked="true"
                        android:text="0°"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rotate_90"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:buttonTint="#FFFFFFFF"
                        android:text="90°"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rotate_180"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:buttonTint="#FFFFFFFF"
                        android:text="180°"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/check_flip_horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:buttonTint="#FFFFFFFF"
                        android:text="Inverter horizontalmente"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/check_flip_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:buttonTint="#FFFFFFFF"
                        android:text="Inverter verticalmente"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/check_metadata_rotation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFFFF"
                            android:checked="false"
                            android:text="Girar pelos metadados"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/help_metadata_rotation"
                            android:layout_width="22dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minHeight="40dp"
                            android:text="?"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/check_parallel_keyframes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FFFFFFFF"
                            android:checked="true"
                            android:text="Processar em paralelo"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/help_parallel_keyframes"
                            android:layout_width="22dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minHeight="40dp"
                            android:text="?"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/label_video_encoder"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="Encoder:"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/button_video_encoder"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="..."
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/help_video_encoder"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/label_video_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:text="Qualidade:"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/button_video_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="Alta"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/help_video_quality"
                        android:layout_width="28dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#99FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/parallel_segments_container"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:text="Processos:"
                            android:textColor="#CCFFFFFF"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/input_parallel_segments"
                            android:layout_width="52dp"
                            android:layout_height="32dp"
                            android:background="@drawable/ffmpeg_outline_button_bg"
                            android:gravity="center"
                            android:hint="#"
                            android:inputType="number"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textColor="#FFFFFFFF"
                            android:textColorHint="#88FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/help_parallel_segments"
                            android:layout_width="20dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="?"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_rotate"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.45"
                    android:background="@drawable/ffmpeg_outline_green_button_bg"
                    android:clickable="false"
                    android:contentDescription="Girar vídeo"
                    android:focusable="false"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_rotate_video" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/output_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF5EDAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/output_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_save_to_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Salvar na pasta"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_save" />

                <ImageButton
                    android:id="@+id/button_output_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir pasta"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_folder" />

                <ImageButton
                    android:id="@+id/button_output_share"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Compartilhar"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_share" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
