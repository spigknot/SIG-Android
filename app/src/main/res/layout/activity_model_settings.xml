<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="22dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Configurações"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modelo de transcrição"
                android:textColor="#FF5EDAF2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="As opções são lidas de SIG/Servidores/modelos_de_transcricao.txt"
                android:textColor="#FFAAAAAA"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/radio_transcription_models"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#88101418"
                    android:orientation="vertical"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/button_add_transcription_server"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Adicionar servidor"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_plus"
                        android:tint="#FF62F28F" />

                    <ImageButton
                        android:id="@+id/button_remove_transcription_server"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Remover servidor selecionado"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_minus"
                        android:tint="#FFFF5A5A" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/transcription_models_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nenhum modelo de transcrição válido foi encontrado."
                android:textColor="#FFFF7777"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                android:background="#665EDAF2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modelos de texto"
                android:textColor="#FF5EDAF2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="As opções são lidas de SIG/Servidores/modelos_de_texto.txt"
                android:textColor="#FFAAAAAA"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/radio_text_models"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#88101418"
                    android:orientation="vertical"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/button_add_text_model"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Adicionar modelo de texto"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_plus"
                        android:tint="#FF62F28F" />

                    <ImageButton
                        android:id="@+id/button_remove_text_model"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Remover modelo de texto selecionado"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_minus"
                        android:tint="#FFFF5A5A" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_models_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nenhum modelo de texto válido foi encontrado."
                android:textColor="#FFFF7777"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                android:background="#665EDAF2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extração de partes"
                android:textColor="#FF5EDAF2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Escolha como os nomes serão identificados no histórico."
                android:textColor="#FFAAAAAA"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/radio_parts_extraction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#88101418"
                    android:orientation="vertical"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/button_add_part_name"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Adicionar nome à base de partes"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_plus"
                        android:tint="#FF62F28F" />

                    <ImageButton
                        android:id="@+id/button_remove_part_name"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Remover nome da base de partes"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_minus"
                        android:tint="#FFFF5A5A" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="22dp"
                android:background="#665EDAF2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STT Remoto"
                android:textColor="#FF5EDAF2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quantidade máxima de áudios enviados ao servidor ao mesmo tempo."
                android:textColor="#FFAAAAAA"
                android:textSize="10sp" />

            <RadioGroup
                android:id="@+id/radio_granite_parallelism"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#88101418"
                android:orientation="vertical"
                android:padding="8dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
