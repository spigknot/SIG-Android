<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="36dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/prompt_section_title" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="#FF5EDAF2" android:textSize="16sp" />
    <!-- Same appearance as RemoteStt Transcrição/button_select_media; only height adapted. -->
    <ImageButton android:id="@+id/button_add_prompt" android:layout_width="44dp"
        android:layout_height="36dp" android:background="@drawable/ffmpeg_outline_button_bg"
        android:clickable="true" android:contentDescription="Novo prompt" android:focusable="true"
        android:foreground="?attr/selectableItemBackground" android:padding="9dp"
        android:scaleType="fitCenter" android:src="@drawable/ic_ffmpeg_select_file" />
</LinearLayout>
