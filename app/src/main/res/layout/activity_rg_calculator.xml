<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/calculator_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Calculadora de Dígitos"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/label_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RG"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#444444"
                android:hint="Digite o RG"
                android:inputType="phone"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#88FFFFFF" />

            <TextView
                android:id="@+id/result_rg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dígito: —"
                android:textColor="#FFBB33"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/history_rg_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/clear_history_rg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:alpha="0.7"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Limpar histórico"
                    android:padding="8dp"
                    android:src="@drawable/ic_broom"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/history_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#AA1B1B1B"
                android:padding="14dp"
                android:fadeScrollbars="false"
                android:maxLines="10"
                android:minLines="1"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toggle_history_rg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="ver mais"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rg_possibilities_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Encontrar RG por posições"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/input_rg_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#444444"
                    android:hint="Use ? para o que não souber. Ex: 12?.456-?"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#88FFFFFF" />

                <TextView
                    android:id="@+id/button_find_rg_possibilities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="buscar possibilidades"
                    android:textColor="#FFBB33"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_rg_possibilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#AA1B1B1B"
                    android:fadeScrollbars="false"
                    android:maxLines="10"
                    android:minLines="1"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="14dp"
                    android:scrollbars="vertical"
                    android:text=""
                    android:textColor="#DDFFFFFF"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/label_cpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="CPF"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_cpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#444444"
                android:hint="Digite os 9 primeiros dígitos"
                android:inputType="phone"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#88FFFFFF" />

            <TextView
                android:id="@+id/result_cpf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Dígitos: —"
                android:textColor="#FFBB33"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/history_cpf_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/clear_history_cpf"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:alpha="0.7"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Limpar histórico CPF"
                    android:padding="8dp"
                    android:src="@drawable/ic_broom"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/history_cpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#AA1B1B1B"
                android:padding="14dp"
                android:fadeScrollbars="false"
                android:maxLines="10"
                android:minLines="1"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toggle_history_cpf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="ver mais"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cpf_possibilities_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Encontrar CPF por posições"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/input_cpf_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#444444"
                    android:hint="Use ? para o que não souber. Ex: 123.???_789-??"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#88FFFFFF" />

                <TextView
                    android:id="@+id/button_find_cpf_possibilities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="buscar possibilidades"
                    android:textColor="#FFBB33"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_cpf_possibilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#AA1B1B1B"
                    android:fadeScrollbars="false"
                    android:maxLines="10"
                    android:minLines="1"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="14dp"
                    android:scrollbars="vertical"
                    android:text=""
                    android:textColor="#DDFFFFFF"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
