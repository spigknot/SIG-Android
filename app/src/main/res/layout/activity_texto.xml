<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:fitsSystemWindows="true">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="76dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginBottom="12dp">
                <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="start|center_vertical" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar" android:src="@drawable/ic_arrow_back" app:tint="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Texto" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
            </FrameLayout>
            <!-- Linha de modelo/backend (mesmo padrão do Granite/Whisper). -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/button_model"
                    android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:minWidth="110dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="1.25bit"
                    android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_backend"
                    android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:minWidth="72dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="CPU"
                    android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_language"
                    android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:minWidth="80dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Português"
                    android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/button_threads"
                    android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:minWidth="60dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Auto"
                    android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Texto original" android:textColor="#99FFFFFF" android:textSize="11sp" />
            <EditText android:id="@+id/input_text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/ffmpeg_outline_button_bg" android:fontFamily="monospace" android:gravity="top|start"
                android:hint="Digite o texto para traduzir" android:textColorHint="#66FFFFFF"
                android:inputType="textMultiLine|textCapSentences" android:maxLines="12" android:minLines="5"
                android:overScrollMode="ifContentScrolls" android:padding="10dp" android:scrollbars="vertical"
                android:textColor="#FFFFFFFF" android:textSize="13sp" />
            <!-- Acoes do texto de ENTRADA: limpar / compartilhar / copiar / colar.
                 Mesmo desenho da barra da Ocorrencia e da saida abaixo. -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_gravity="end" android:layout_marginEnd="6dp" android:layout_marginTop="2dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="30dp" android:layout_gravity="end|center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/button_clear_input" android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/ffmpeg_outline_button_bg" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="LIMPAR" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
                    <ImageButton android:id="@+id/button_share_input" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="5dp" android:background="@drawable/ffmpeg_outline_button_bg" android:contentDescription="Compartilhar texto original" android:foreground="?attr/selectableItemBackground" android:padding="9dp" android:src="@drawable/ic_ffmpeg_share" />
                    <ImageButton android:id="@+id/button_copy_input" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="5dp" android:background="@drawable/ffmpeg_outline_button_bg" android:contentDescription="Copiar texto original" android:foreground="?attr/selectableItemBackground" android:padding="7dp" android:src="@drawable/ic_copy_outline" />
                    <ImageButton android:id="@+id/button_paste_input" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/ffmpeg_outline_button_bg" android:contentDescription="Colar texto" android:foreground="?attr/selectableItemBackground" android:padding="7dp" android:src="@drawable/ic_paste_outline" />
                </LinearLayout>
            </FrameLayout>
            <!-- Botao principal: mesma geometria/estetica dos botoes Historico e
                 Oitiva da ferramenta de Ocorrencia (FrameLayout de 30dp,
                 gravity=center, marginTop=2dp, 10sp, verde #FF5EF08E). -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_gravity="center" android:layout_marginTop="2dp">
                <TextView android:id="@+id/button_translate"
                    android:layout_width="wrap_content" android:layout_height="30dp" android:layout_gravity="center"
                    android:background="@drawable/ffmpeg_outline_green_button_bg"
                    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Traduzir"
                    android:textColor="#FF5EF08E" android:textSize="10sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Tradução" android:textColor="#99FFFFFF" android:textSize="11sp" />
            <EditText android:id="@+id/output_text"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/ffmpeg_outline_button_bg" android:fontFamily="monospace" android:gravity="top|start"
                android:hint="A tradução aparece aqui" android:textColorHint="#66FFFFFF"
                android:inputType="textMultiLine|textCapSentences" android:maxLines="20" android:minLines="5"
                android:overScrollMode="ifContentScrolls" android:padding="10dp" android:scrollbars="vertical"
                android:textColor="#FFB8F7FF" android:textSize="13sp" />
            <!-- Acoes da traducao: Limpar / Salvar / Compartilhar / Copiar / Colar.
                 Mesmo desenho da barra da Ocorrencia (30dp, marginEnd=6dp,
                 icones com o mesmo padding). -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_gravity="end" android:layout_marginEnd="6dp" android:layout_marginTop="2dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="30dp" android:layout_gravity="end|center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/button_clear_translation" android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/ffmpeg_outline_button_bg" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="LIMPAR" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
                    <TextView android:id="@+id/button_save_translation" android:layout_width="58dp" android:layout_height="30dp" android:layout_marginStart="5dp" android:background="@drawable/ffmpeg_outline_button_bg" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="SALVAR" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold" />
                    <ImageButton android:id="@+id/button_share_translation" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="5dp" android:background="@drawable/ffmpeg_outline_button_bg" android:contentDescription="Compartilhar tradução" android:foreground="?attr/selectableItemBackground" android:padding="9dp" android:src="@drawable/ic_ffmpeg_share" />
                    <ImageButton android:id="@+id/button_copy_translation" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="5dp" android:background="@drawable/ffmpeg_outline_button_bg" android:contentDescription="Copiar tradução" android:foreground="?attr/selectableItemBackground" android:padding="7dp" android:src="@drawable/ic_copy_outline" />
                    <ImageButton android:id="@+id/button_paste_translation" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/ffmpeg_outline_button_bg" android:contentDescription="Colar texto" android:foreground="?attr/selectableItemBackground" android:padding="7dp" android:src="@drawable/ic_paste_outline" />
                </LinearLayout>
            </FrameLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#DDFFFFFF" android:textSize="12sp" />
            <!-- Log informativo de cada passo (padrão do terminal do Whisper). -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Log" android:textColor="#99FFFFFF" android:textSize="11sp" />
            <ScrollView android:id="@+id/terminal_scroll"
                android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="4dp"
                android:background="@drawable/ffmpeg_outline_button_bg" android:fillViewport="true" android:padding="8dp">
                <TextView android:id="@+id/terminal_text"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:textColor="#FFB8F7FF" android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
