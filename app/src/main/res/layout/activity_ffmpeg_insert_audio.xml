<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/insert_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Inserir áudio"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_select_main_audio"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:contentDescription="Selecionar áudio principal"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:src="@drawable/ic_ffmpeg_select_file" />

                <ImageButton
                    android:id="@+id/button_select_insert_audio"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:alpha="0.4"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:contentDescription="Selecionar áudio para inserir"
                    android:enabled="false"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:src="@drawable/ic_ffmpeg_plus"
                    app:tint="#FFFFC24A" />

                <ImageView
                    android:id="@+id/arrow_input_output"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    android:visibility="gone"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/button_select_output_folder"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:contentDescription="Selecionar pasta de saída"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="12dp"
                    android:src="@drawable/ic_ffmpeg_folder"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/selected_main_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="1"
                android:text="Selecione o áudio principal"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/selected_insert_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFC24A"
                android:textSize="13sp"
                android:visibility="gone" />

            <br.gov.sp.pcsp.launcher.FfmpegInsertAudioTimelineView
                android:id="@+id/insert_timeline"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="12dp"
                android:enabled="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_speed_down"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Desacelerar"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_speed_down"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/button_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reproduzir"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_play"
                    app:tint="#FFFFFFFF" />

                <ImageButton
                    android:id="@+id/button_speed_up"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Acelerar"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_speed_up"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_insert_time"
                android:layout_width="146dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ffmpeg_outline_button_bg"
                android:digits="0123456789:.,"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="00:00:00.000"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="12"
                android:singleLine="true"
                android:text="00:00:00.000"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#88FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/insert_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/button_transition"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minWidth="132dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Transição: Sem"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/input_transition_time"
                        android:layout_width="68dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:digits="0123456789.,"
                        android:gravity="center"
                        android:hint="seg"
                        android:inputType="numberDecimal"
                        android:maxLength="4"
                        android:singleLine="true"
                        android:text="0.5"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#88FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/check_reencode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFFFFFFF"
                        android:text="Reencodar"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/check_smart_insert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:buttonTint="#FFFFFFFF"
                        android:text="Smart Insert"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_insert"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/ffmpeg_outline_green_button_bg"
                    android:contentDescription="Inserir áudio"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:src="@drawable/ic_ffmpeg_insert_audio" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#DDFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/output_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FF5EDAF2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/output_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_save_to_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Salvar na pasta"
                    android:padding="8dp"
                    android:src="@drawable/ic_ffmpeg_save" />

                <ImageButton
                    android:id="@+id/button_output_folder"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Abrir pasta"
                    android:padding="7dp"
                    android:src="@drawable/ic_ffmpeg_folder"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/button_output_share"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Compartilhar"
                    android:padding="8dp"
                    android:src="@drawable/ic_ffmpeg_share"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_sig_echo_footer" />
</FrameLayout>
