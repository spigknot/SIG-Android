<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/granite_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="STT (Granite)"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_select_media"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Selecionar áudio ou vídeo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_select_file" />
            </LinearLayout>

            <TextView
                android:id="@+id/terminal_text"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="0dp"
                android:background="#CC050607"
                android:fontFamily="monospace"
                android:maxLines="34"
                android:minLines="34"
                android:overScrollMode="ifContentScrolls"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text="$ granite --aguardando arquivo"
                android:textColor="#FFFFC928"
                android:textIsSelectable="false"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/selected_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/button_model"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Modelo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/button_backend"
                    android:layout_width="104dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:gravity="center"
                    android:text="CPU"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/button_transcribe"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:alpha="0.45"
                android:background="@drawable/ffmpeg_outline_green_button_bg"
                android:clickable="false"
                android:contentDescription="Transcrever"
                android:focusable="false"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_whisper_transcribe"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="#FFFFC928"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#FFFFC928"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/log_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:text="Log"
                android:textColor="#FFFFC928"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                android:background="#661B1B1B"
                android:fontFamily="monospace"
                android:maxLines="20"
                android:minLines="6"
                android:overScrollMode="ifContentScrolls"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:textColor="#CCFFFFFF"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/output_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/output_file_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="#FF5EDAF2"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/button_output_export"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:contentDescription="Exportar"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_share" />

                <ImageButton
                    android:id="@+id/button_output_folder"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:contentDescription="Abrir pasta"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_folder" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
