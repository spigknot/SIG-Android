<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/granite_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- cabeçalho -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="18dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Voltar"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="STT (Granite)"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- barra de seleção: + arquivo, modelo, backend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_select_media"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Selecionar áudio ou vídeo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ffmpeg_select_file" />

                <TextView
                    android:id="@+id/button_model"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:maxLines="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="Modelo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/button_backend"
                    android:layout_width="104dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="CPU"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- botão verde de transcrever -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false">

                <ImageButton
                    android:id="@+id/button_transcribe"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:alpha="0.45"
                    android:background="@drawable/ffmpeg_outline_green_button_bg"
                    android:clickable="false"
                    android:contentDescription="Transcrever"
                    android:focusable="false"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_whisper_transcribe"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- barra de progresso -->
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="#FFFFC928"
                android:visibility="gone" />

            <!-- status -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#FFFFC928"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- caixa de texto da transcrição (copiada da Ocorrência) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/output_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#CC050607"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:maxLines="30"
                    android:minLines="5"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:textColor="#FFB8F7FF"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- botões de clipboard (copiados da Ocorrência) -->
            <FrameLayout
                android:id="@+id/live_transcript_clipboard_actions"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="2dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_recover_transcript"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/ffmpeg_outline_button_bg"
                    android:clickable="true"
                    android:contentDescription="Recuperar transcrição"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:src="@drawable/ic_reload_outline" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/button_clear_transcript"
                        android:layout_width="52dp"
                        android:layout_height="30dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="LIMPAR"
                        android:textColor="#FFFFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/button_share_live_transcript"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:contentDescription="Compartilhar transcrição"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="9dp"
                        android:src="@drawable/ic_ffmpeg_share" />

                    <ImageButton
                        android:id="@+id/button_copy_live_transcript"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:contentDescription="Copiar transcrição"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="7dp"
                        android:src="@drawable/ic_copy_outline" />

                    <ImageButton
                        android:id="@+id/button_paste_transcript"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/ffmpeg_outline_button_bg"
                        android:contentDescription="Colar transcrição"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="7dp"
                        android:src="@drawable/ic_paste_outline" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>