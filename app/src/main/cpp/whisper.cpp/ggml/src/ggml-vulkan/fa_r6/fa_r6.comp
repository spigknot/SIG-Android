#version 450
// R11/fase C (C2-fix, 2026-10-15): o dot product passa a usar SEMPRE o caminho
// MANUAL_XOR_REDUCE (soma em árvore por subgroupShuffleXor) em vez de
// `subgroupAdd`. Motivo: o `subgroupAdd` do driver Adreno 740 apresentou
// miscompilação INTERMITENTE dependente de regime térmico/clock — o decoder
// entrava em loop de tokens (WER 0,2–0,9) em ~50% das execuções no calor e ~10%
// no frio. Evidência completa: build/whisper-rodada11/20261014-1104/CHECKPOINT-C2
// (A/B no mesmo regime quente: redução atual 5/10 falhas × XOR 0/10; Fisher
// p≈0,032; CPU e FA-off imunes). A macro continua disponível para o caminho
// oposto em diagnóstico; o define abaixo fixa o default de produção.
#define MANUAL_XOR_REDUCE 1
// R7/fase A (A3) — Variante FA compacta do whisper, com MÁSCARA EM ÍNDICE
// INTEIRO (sem conversão para float; a R6 usava float(m_off) e podia perder
// precisão em máscaras grandes — reprovado na revisão da R6).
//
// Contrato REAL: Q f32, K/V f16, head_dim D=64 (Q/K/V/O), output f32.
// UM workgroup por (linha n, head h); WG=64 com lane = dimensão d; dot por
// redução de subgroup; online softmax m/l/o em F32; loop de KV com bounds
// RUNTIME (sem unroll, sem arrays vivos). Streaming de K/V: 1 chave/iteração.
//
// Recusas FORA do shader (host, ggml-vulkan-fa-r6-guards.h — preflight de shape):
// quantizados, ALiBi(max_bias)/softcap/sinks/GQA, dst não contíguo [D,heads,N,batch],
// strides não divisíveis pelo tipo, máscara não densa / broadcast != {1,heads}×{1,batch},
// índices u32 estourando, grid além dos limites do device.
//
// Push constants = MESMO layout de 128B do flash_attn_base.glsl (campos usados
// exatamente nas mesmas posições: N,KV,ne*,neq*,nek*,nev*,nem*,nb*,scale,...).
// Bindings espelham o contrato do ggml: 0=Q, 1=K, 2=V, 3=mask(f16), 5=O.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

layout(local_size_x = 64) in;

// spec 0 = MASK_ENABLE (0/1)  (única constante de especialização usada)
layout(constant_id = 0) const uint MASK_ENABLE = 0;

layout(push_constant) uniform parameter {
    uint N;
    uint KV;

    uint ne1;   // dst->ne[1] = n_head (linhas de O por head)
    uint ne2;   // dst->ne[2] = N (linhas de query)
    uint ne3;   // dst->ne[3] = batch

    uint neq2;
    uint neq3;
    uint nek2;
    uint nek3;
    uint nev2;
    uint nev3;
    uint nem1;
    uint nem2;
    uint nem3;

    uint nb01;
    uint nb02;
    uint nb03;
    uint nb11;
    uint nb12;
    uint nb13;
    uint nb21;
    uint nb22;
    uint nb23;

    float scale;
    float max_bias;
    float logit_softcap;

    uint mask_n_head_log2;
    float m0;
    float m1;

    uint gqa_ratio;
    uint split_kv;
    uint k_num;
} p;

layout(binding = 0) readonly buffer Q { float data_q[]; };
layout(binding = 1) readonly buffer K { float16_t data_k[]; };
layout(binding = 2) readonly buffer V { float16_t data_v[]; };
layout(binding = 3) readonly buffer M { float16_t data_m[]; };
layout(binding = 5) writeonly buffer O { float data_o[]; };

const uint  D_HEAD = 64u;

void main() {
    // mesmo sentinela do flash_attn.comp do ggml (evita NaN em e^(Mold-M))
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);

    const uint d     = gl_LocalInvocationIndex;   // dimensão do head (0..63)
    const uint row   = gl_WorkGroupID.x;          // linha de query
    const uint head  = gl_WorkGroupID.y;
    const uint batch = gl_WorkGroupID.z;

    const uint q_off = (batch * p.nb03 + head * p.nb02) / 4u + row * p.nb01 + d;
    const uint k_off = (batch * p.nb13 + head * p.nb12) / 2u;
    const uint v_off = (batch * p.nb23 + head * p.nb22) / 2u;

    // R7/A3: índice da máscara SEMPRE em inteiro (uint) — nenhum caminho
    // converte o índice para float. O host (guards) garante que o índice
    // máximo cabe em u32 e que o layout denso/broadcast é o suportado.
    uint m_off = 0u;  // usado só com MASK_ENABLE=1
    if (MASK_ENABLE == 1u) {
        uint mo = 0u;
        if (p.nem2 != 1u || p.nem3 != 1u) {
            mo = ((batch % p.nem3) * p.nem2 + (head % p.nem2)) * p.nem1 * p.KV;
        }
        m_off = mo + row * p.KV;
    }

    const float qd = data_q[q_off];

    float m = NEG_FLT_MAX_OVER_2;
    float l = 0.0;
    float acc = 0.0;

    // streaming de chaves: sem unroll, bounds do loop em runtime
    for (uint t = 0u; t < p.KV; ++t) {
        const float kd = float(data_k[k_off + t * p.nb11 + d]);
#ifdef MANUAL_XOR_REDUCE
        float s = qd * kd;
        [[unroll]] for (uint off = 32u; off > 0u; off >>= 1) {
            s += subgroupShuffleXor(s, off);
        }
        s *= p.scale;
#else
        float s = subgroupAdd(qd * kd) * p.scale;
#endif
        if (MASK_ENABLE == 1u) {
            s += float(data_m[m_off + t]);
        }
        const float mn = max(m, s);
        const float alpha = exp(m - mn);
        const float w = exp(s - mn);
        l = l * alpha + w;
        acc = acc * alpha + w * float(data_v[v_off + t * p.nb21 + d]);
        m = mn;
    }

    const float res = (l > 0.0) ? acc / l : 0.0;
    // O: [D, n_head, N, batch] CONTÍGUO (layout do dst do ggml FA; o host
    // recusa dst com strides fora deste layout — guards §dst).
    const uint o_off = d + head * D_HEAD + row * p.ne1 * D_HEAD + batch * p.ne2 * p.ne1 * D_HEAD;
    data_o[o_off] = res;
}
