#!/bin/sh
set -eu

root="$(git rev-parse --show-toplevel)"
power_shell=""

for candidate in pwsh pwsh.exe powershell.exe powershell; do
    if command -v "$candidate" >/dev/null 2>&1; then
        power_shell="$candidate"
        break
    fi
done

if [ -z "$power_shell" ]; then
    echo "SIG: PowerShell (pwsh ou powershell.exe) e necessario para o pre-commit." >&2
    exit 2
fi

exec "$power_shell" \
    -NoLogo \
    -NoProfile \
    -NonInteractive \
    -ExecutionPolicy Bypass \
    -File "$root/scripts/validate-agent-harness.ps1" \
    -Staged \
    -RunAndroidGates \
    -Quiet
